# ===== Google OAuth（Gmail 唯讀 + Drive）=====
# 從 Google Cloud Console 建立「桌面應用程式」類型的 OAuth 用戶端
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 執行 `npm run auth` 後取得
GOOGLE_REFRESH_TOKEN=

# ===== Google Cloud TTS（--script-only 時不需要）=====
# 服務帳戶金鑰 JSON 的完整內容（壓成單行），或整份 JSON 的 base64 編碼
GOOGLE_TTS_CREDENTIALS=

# ===== Claude =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_CLASSIFY_MODEL=claude-haiku-5-5

# ===== Gmail =====
GMAIL_QUERY=is:unread newer_than:1d
# 是否跳過 F1-2 分類：auto（查詢含 label: 時跳過）/ true / false
SKIP_CLASSIFY=auto
MAX_CANDIDATES=50
MAX_EMAILS=20

# ===== 內容 =====
MAX_DEEP_ITEMS=3
SCRIPT_TARGET_CHARS=2800

# ===== TTS / Drive（Phase 2、3）=====
# 預設用 Gemini-TTS（較自然）。設成 none 改用舊式語音，此時 TTS_VOICE 要填例如 cmn-TW-Wavenet-A
TTS_MODEL=gemini-2.5-flash-tts
# Gemini 語音名稱，例如 Kore、Aoede、Puck、Charon（`npm run voices -- --sample` 可試聽）
TTS_VOICE=Kore
TTS_LANGUAGE=cmn-TW
# 語氣、語速的自然語言指示（僅 Gemini-TTS），留空使用內建預設
TTS_STYLE_PROMPT=
# 以下兩項僅舊式語音（TTS_MODEL=none）使用；Gemini-TTS 的語速請寫在 TTS_STYLE_PROMPT
TTS_SPEAKING_RATE=1.1
# 音調，-20 ～ 20，0 為原始音調（部分語音不支援，設 0 時不會送出）
TTS_PITCH=0
RETENTION_DAYS=7
